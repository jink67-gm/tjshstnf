rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 서·논술형 평가 연습실: 연수 방(rooms)과 참여자 점수(scores)만 허용
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if roomId.matches('^[0-9]{4}$');
      allow delete: if false;
      match /scores/{scoreId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['pid','name','round','scores','at'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 20;
        allow delete: if false;
      }
    }
  }
}
